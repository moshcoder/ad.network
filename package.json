{
  "name": "@profullstack/adnetwork",
  "version": "0.3.1",
  "description": "ad.network: run ads, or earn from your site, in crypto. Paste a link and a budget, or paste one tag and add a wallet. Web, API, CLI, TUI and MCP; ads by crawlproof, payments by CoinPay.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://ad.network.pit.world",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moshcoder/ad.network.git"
  },
  "bin": {
    "adnetwork": "bin/adnetwork"
  },
  "files": [
    "bin/adnetwork",
    "src",
    "public",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.1"
  },
  "keywords": [
    "ads",
    "advertising",
    "ad network",
    "publishers",
    "crypto",
    "usdc",
    "mcp",
    "agents",
    "crawlproof",
    "coinpay"
  ],
  "scripts": {
    "start": "bun src/server.ts",
    "dev": "bun --watch src/server.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@profullstack/affiliates": "0.3.0",
    "@profullstack/coinpay-onboard": "^0.2.0",
    "@profullstack/footer": "^0.4.0",
    "@profullstack/hqtui": "^0.11.0",
    "@profullstack/redeem-credits": "0.2.0",
    "@profullstack/webhooks": "0.2.1",
    "hono": "^4.13.14",
    "mailchecker": "^6.0.21",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/qrcode": "^1.5.6",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "zod": "^4.6.7"
  }
}
